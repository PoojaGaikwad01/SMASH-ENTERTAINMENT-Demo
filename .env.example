APP_NAME="Smash Entertainment"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smash_enquiries
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bookings@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Smash Entertainment enquiry & booking system (config/leads.php) ---
# mock = no real Meta/WhatsApp/FCM/AI/email/payment calls (logged instead); live = real APIs
APP_MODE=mock

META_GRAPH_VERSION=v21.0
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
IG_ACCOUNT_ID=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Legacy agency parsing (off for Smash). When false, AGENCY_NUMBERS is ignored.
AGENCY_PARSING_ENABLED=false
# Comma-separated WhatsApp numbers of agencies. 919900000001 is the mock agency used by tests/fixtures/meta — replace in production.
AGENCY_NUMBERS=919900000001

# AI parsing is optional; none = skip
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Optional: path to Firebase service-account JSON; empty = in-app bell only
FIREBASE_CREDENTIALS_PATH=
REMINDER_AFTER_MINUTES=60
# Meta webhook log (object + message ids only). Default storage/logs/meta.log; Docker uses php://stderr
# LOG_META_PATH=
DEDUPE_DAYS=7

OUTLET_DEFAULT_TIMEZONE=Asia/Kolkata
FOLLOW_UP_DEFAULT_HOURS=24
PUBLIC_FORM_ENABLED=true
# Website origin(s) allowed to POST /api/enquiries from the browser (CORS), comma-separated
WEBSITE_ALLOWED_ORIGINS=https://www.example.com

# WhatsApp template names (approved in Meta Business Manager). Body variables, in order:
#   confirmation: {{1}} name {{2}} booking code {{3}} date {{4}} time {{5}} outlet {{6}} area · package {{7}} guests {{8}} balance due
#   reminder:     {{1}} name {{2}} booking code {{3}} date {{4}} time {{5}} outlet
#   thank_you:    {{1}} name {{2}} outlet
#   payment_link: {{1}} name {{2}} amount {{3}} booking code {{4}} payment link {{5}} link expiry
# Blank in live mode = WhatsApp skipped for that message (email still sent). Ignored in mock mode.
WA_TEMPLATE_PAYMENT_LINK=
WA_TEMPLATE_CONFIRMATION=
WA_TEMPLATE_REMINDER=
WA_TEMPLATE_THANK_YOU=
WA_TEMPLATE_LANG=en

# Booking notifications (scheduler: bookings:send-notifications every 15 min). Email uses MAIL_* above.
REMINDER_HOURS_BEFORE=24
THANK_YOU_HOURS_AFTER=3

# Booking export for the POS / Semnox (not integrated yet): none | csv.
# csv → storage/app/private/{BOOKING_EXPORT_PATH}/booking-events-YYYY-MM-DD.csv (every change) + bookings-YYYY-MM-DD.csv (php artisan bookings:export, daily 06:00)
BOOKING_EXPORT_DRIVER=none
BOOKING_EXPORT_PATH=exports

# Payments (Razorpay Payment Links) — only used when PAYMENTS_ENABLED=true.
# Webhook URL: https://<your-domain>/webhooks/razorpay, events payment_link.paid + payment_link.expired.
# APP_MODE=mock: no Razorpay calls; use "Mark as paid (mock)" on the booking page.
PAYMENTS_ENABLED=false
PAYMENT_ADVANCE_PERCENT=50
PAYMENT_LINK_EXPIRY_HOURS=48
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
